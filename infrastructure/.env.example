# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=fiap
POSTGRES_PASSWORD=fiap
POSTGRES_DB=fiap
DATABASE_URL=postgresql+asyncpg://fiap:fiap@postgres:5432/fiap

# ============================================
# RABBITMQ CONFIGURATION
# ============================================
RABBITMQ_USER=fiap
RABBITMQ_PASSWORD=fiap
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# ============================================
# AI/LLM CONFIGURATION
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek/deepseek-v3.2
AI_SERVICE_URL=http://ai-service:8003

# Strends Swarm
MAX_HANDOFFS=20 # Maximum number of agent handoffs allowed
MAX_ITERATIONS=20 # Maximum total iterations across all agents
EXECUTION_TIMEOUT=120.0  # 2 MINUTES
NODE_TIMEOUT=60.0       # 60 Individual agent timeout in seconds
REPETITIVE_HANDOFF_DETECTION_WINDOW=8  # THERE MUST BE >= 3 UNIQUE AGENTS IN THE LAST 8 HANDOFFS
REPETITIVE_HANDOFF_MIN_UNIQUE_AGENTS=3 # Minimum unique nodes required in recent sequence

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GRAFANA_USER=fiap
GRAFANA_PASSWORD=fiap

# ============================================
# SERVICE CONFIGURATION
# ============================================
UPLOAD_SERVICE_PORT=8001
PROCESSING_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004

# ============================================
# MINIO CONFIGURATION
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fiap
MINIO_SECRET_KEY=fiap1234
MINIO_BUCKET=fiap
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ============================================
# OBSERVABILITY
# ============================================
PROMETHEUS_PORT=9090
SERVICE_NAME=arch-analyzer