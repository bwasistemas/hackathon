# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=fiap
POSTGRES_PASSWORD=fiap
POSTGRES_DB=fiap
DATABASE_URL=postgresql+asyncpg://fiap:fiap@postgres:5432/fiap

# ============================================
# RABBITMQ CONFIGURATION
# ============================================
RABBITMQ_USER=fiap
RABBITMQ_PASSWORD=fiap
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# ============================================
# AI/LLM CONFIGURATION
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://ai-service:8003

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GRAFANA_USER=fiap
GRAFANA_PASSWORD=fiap

# ============================================
# SERVICE CONFIGURATION
# ============================================
UPLOAD_SERVICE_PORT=8001
PROCESSING_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004

# ============================================
# MINIO CONFIGURATION
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fiap
MINIO_SECRET_KEY=fiap1234
MINIO_BUCKET=fiap
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ============================================
# OBSERVABILITY
# ============================================
PROMETHEUS_PORT=9090
SERVICE_NAME=arch-analyzer