# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=fiap
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=fiap
DATABASE_URL=postgresql+asyncpg://fiap:change-me-in-production@postgres:5432/fiap

# ============================================
# RABBITMQ CONFIGURATION
# ============================================
RABBITMQ_USER=fiap
RABBITMQ_PASSWORD=change-me-in-production
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# ============================================
# AI / LLM CONFIGURATION
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek/deepseek-v3.2
AI_SERVICE_URL=http://ai-service:8003
# Multimodal model for diagram OCR (same OPENAI_API_KEY / OPENAI_BASE_URL as LLM_MODEL — e.g. OpenRouter).
# Falls back to Tesseract if the call fails or LLM_OCR_DISABLE=true.
LLM_OCR=google/gemma-4-26b-a4b-it
# LLM_OCR_MAX_PDF_PAGES=15
# LLM_OCR_MAX_TOKENS=4096
# LLM_OCR_IMAGE_MAX_SIDE=2048
# LLM_OCR_PDF_DPI=150
# LLM_OCR_DISABLE=false
# Force JSON object output from the analysis model (OpenAI-compatible). Retry without it if the provider rejects.
# LLM_ANALYSIS_JSON_OBJECT=true

# Strands Swarm
MAX_HANDOFFS=20
MAX_ITERATIONS=20
EXECUTION_TIMEOUT=120.0
NODE_TIMEOUT=60.0
REPETITIVE_HANDOFF_DETECTION_WINDOW=8
REPETITIVE_HANDOFF_MIN_UNIQUE_AGENTS=3

# ============================================
# SECURITY / AUTHENTICATION
# ============================================
# IMPORTANT: This secret is used to sign and verify JWTs across the
# upload-service, report-service and ai-service. It MUST be the same value in
# every service and MUST be rotated before going to production.
#
# Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Default admin credentials used by the frontend login screen.
# Do NOT use the legacy "admin/admin123" defaults: the upload-service refuses
# to authenticate when those values are detected.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production

# Comma-separated list of origins allowed by CORS.
# Use the exact frontend URL(s); never use "*" together with credentials.
ALLOWED_ORIGINS=http://localhost:8051

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# ============================================
# SERVICE CONFIGURATION
# ============================================
UPLOAD_SERVICE_PORT=8001
PROCESSING_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004

# ============================================
# MINIO CONFIGURATION
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fiap
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=fiap
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ============================================
# OBSERVABILITY
# ============================================
PROMETHEUS_PORT=9090
SERVICE_NAME=arch-analyzer
