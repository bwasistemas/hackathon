# ============================================
# DATABASE
# ============================================
POSTGRES_USER=fiap
POSTGRES_PASSWORD=<senha-forte>
# arch_uploads é criado como banco padrão pelo PostgreSQL (POSTGRES_DB).
# arch_reports é criado pelo init-databases.sh na primeira inicialização.
# Cada serviço recebe sua própria DATABASE_URL apontando para seu banco dedicado.
# ATENCAO: em deploys existentes com PVC, execute manualmente:
#   psql -U fiap -c "CREATE DATABASE arch_reports OWNER fiap;"

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_USER=fiap
RABBITMQ_PASSWORD=<senha-forte>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# ============================================ 
# AI / LLM
# ============================================
OPENAI_API_KEY=sk-...
# Endpoint compatível com OpenAI (pode ser OpenRouter, Azure OpenAI, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek/deepseek-v3.2
# URL interna do ai-service (usada por upload-service para callbacks)
AI_SERVICE_URL=http://ai-service:8003

# Modelo multimodal para OCR de diagramas (mesmos OPENAI_API_KEY / OPENAI_BASE_URL)
# Fallback: Tesseract caso a chamada falhe ou LLM_OCR_DISABLE=true
LLM_OCR=google/gemma-4-26b-a4b-it
# LLM_OCR_MAX_PDF_PAGES=15
# LLM_OCR_MAX_TOKENS=4096
# LLM_OCR_IMAGE_MAX_SIDE=2048
# LLM_OCR_PDF_DPI=150
# LLM_OCR_DISABLE=false
# LLM_ANALYSIS_JSON_OBJECT=true

# Strands Swarm
MAX_HANDOFFS=20
MAX_ITERATIONS=20
EXECUTION_TIMEOUT=120.0
NODE_TIMEOUT=60.0
REPETITIVE_HANDOFF_DETECTION_WINDOW=8
REPETITIVE_HANDOFF_MIN_UNIQUE_AGENTS=3

# ============================================
# SEGURANÇA / AUTENTICAÇÃO
# ============================================
# Compartilhado entre upload-service, ai-service e report-service.
# DEVE ser o mesmo valor nos três serviços.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<minimo-48-chars-aleatorios>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Credenciais do usuário admin da aplicação.
ADMIN_USER=fiap
ADMIN_PASSWORD=<senha-forte>

# Origens permitidas pelo CORS — use a URL exata do frontend; nunca use "*" com credentials.
# Em produção, o pipeline define automaticamente como https://<DOMAIN_PROD>.
ALLOWED_ORIGINS=http://localhost:8051

# ============================================
# GRAFANA
# ============================================
GRAFANA_USER=fiap
GRAFANA_PASSWORD=<senha-forte>

# ============================================
# SERVIÇOS — PORTAS INTERNAS DOS CONTAINERS
# (fixas; as portas expostas no HOST ficam na seção CD abaixo)
# ============================================
UPLOAD_SERVICE_PORT=8001
PROCESSING_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004

# Credenciais de servico — usadas pelo report-service para chamar a API do upload-service.
# Devem ter o mesmo valor que ADMIN_USER e ADMIN_PASSWORD.
UPLOAD_SERVICE_URL=http://upload-service:8001
UPLOAD_SERVICE_USER=${ADMIN_USER}
UPLOAD_SERVICE_PASSWORD=${ADMIN_PASSWORD}

# ============================================
# MINIO
# ============================================
# MINIO_ACCESS_KEY é o usuário root do MinIO (equivalente a MINIO_ROOT_USER).
# MINIO_SECRET_KEY é a senha root (equivalente a MINIO_ROOT_PASSWORD).
# Ambos são usados tanto pelo container MinIO quanto pelos serviços clientes.
MINIO_ACCESS_KEY=fiap
MINIO_SECRET_KEY=<senha-forte>
MINIO_BUCKET=fiap
MINIO_ENDPOINT=minio:9000
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ============================================
# TIMEZONE
# ============================================
# Fuso horário dos containers. Deve bater com o fuso do host para evitar logs
# com hora incorreta. Ver também: /etc/localtime montado em cada serviço.
TZ=America/Sao_Paulo

# ============================================
# OBSERVABILIDADE
# ============================================
PROMETHEUS_PORT=9090
SERVICE_NAME=arch-analyzer
# Diretório de logs dos serviços Python
LOG_DIR=/var/log/archianalyzer

# ============================================
# CD — IMAGEM E PORTAS DO HOST
# ============================================
# Tag da imagem GHCR — atualizada automaticamente pelo pipeline de CI/CD.
# Formato: <branch>-<short-sha> (ex: main-a1b2c3d)
IMAGE_TAG=main

# Portas expostas no HOST (padrões funcionam para desenvolvimento local).
# Em HOMOLOGAÇÃO, use valores diferentes para evitar conflito com produção:
#   FRONTEND_HOST_PORT=8151
#   POSTGRES_HOST_PORT=5433
#   RABBITMQ_HOST_PORT=5673
#   RABBITMQ_MANAGEMENT_HOST_PORT=15673
#   RABBITMQ_PROMETHEUS_HOST_PORT=15693
#   MINIO_API_HOST_PORT=9012      ← diferente de prod (9010)
#   MINIO_CONSOLE_HOST_PORT=9013  ← diferente de prod (9011)
#   UPLOAD_HOST_PORT=8101
#   AI_HOST_PORT=8103
#   REPORT_HOST_PORT=8104
#   PROMETHEUS_HOST_PORT=9091
#   LOKI_HOST_PORT=3101
#   GRAFANA_HOST_PORT=3001
#
# Em PRODUÇÃO, apenas MinIO precisa ser alterado (evitar conflito com Portainer na 9000):
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
