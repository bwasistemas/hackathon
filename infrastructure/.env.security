# Security Configuration
# JWT Secret Key - MUST be changed in production
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-here-change-this-in-production

# Logging Directory
LOG_DIR=/var/log/archianalyzer

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8051,https://yourdomain.com

# Rate Limiting
UPLOAD_RATE_LIMIT=5/minute
REPORT_RATE_LIMIT=10/minute
AI_ANALYSIS_RATE_LIMIT=10/minute

# Security Headers
SECURITY_HEADERS_ENABLED=true

# Database Security
DB_SSL_MODE=require
DB_CONNECTION_TIMEOUT=30

# MinIO Security
MINIO_SECURE=true
MINIO_SSL=true

# RabbitMQ Security
RABBITMQ_SSL=true

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true